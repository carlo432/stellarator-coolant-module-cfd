FoamFile { version 2.0; format ascii; class dictionary; object setExprFieldsDict; }

// Trip turbulence: parabolic streamwise profile (peak ~1.5*Ubar) + 3D sinusoidal perturbations
// to break symmetry so the wall-modeled LES transitions quickly instead of sitting laminar.
expressions
(
    U
    {
        field       U;
        dimensions  [0 1 -1 0 0 0 0];
        expression
        #{
            vector
            (
                1.74*(1.0 - sqr(pos().y()/0.01 - 1.0))
                    + 0.35*sin(40.0*pos().z())*cos(3000.0*pos().y()),
                0.35*sin(35.0*pos().x())*sin(28.0*pos().z()),
                0.35*cos(32.0*pos().x())*sin(2500.0*pos().y())
            )
        #};
    }
);
