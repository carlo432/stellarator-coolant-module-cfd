/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application pimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 0.01;
deltaT 0.0001;
writeControl runTime;
writeInterval 0.002;
purgeWrite 0;
writeFormat ascii;
writePrecision 8;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable true;
adjustTimeStep yes;
maxCo 0.5;
maxDeltaT 0.00025;

functions
{
    Htransport
    {
        type scalarTransport;
        libs ("libsolverFunctionObjects.so");
        field H;
        schemesField H;
        // Use turbulence-model scalar diffusivity. Setting D directly forces
        // molecular-only transport and drops the LES SGS thermal flux.
        // D_eff = alphaD*nu + alphaDt*nut = nu/Pr + nut/Prt_sgs.
        alphaD 0.0694444444444;
        alphaDt 1.11111111111;
        nCorr 1;
        resetOnStartUp false;
        writeControl writeTime;

        fvOptions
        {
            kawamuraSource
            {
                type scalarSemiImplicitSource;
                volumeMode specific;
                selectionMode all;

                sources
                {
                    H
                    {
                        explicit
                        {
                            type exprField;
                            expression #{ 5.567004*(U.x()/0.86) #};
                        }
                    }
                }
            }
        }

    }

    fieldAverage1
    {
        type fieldAverage;
        libs ("libfieldFunctionObjects.so");
        timeStart 0.004;
        writeControl writeTime;
        restartOnOutput false;
        fields
        (
            U { mean on; prime2Mean on; base time; }
            H { mean on; prime2Mean on; base time; }
            p { mean on; prime2Mean on; base time; }
        );
    }

    yPlus
    {
        type yPlus;
        libs ("libfieldFunctionObjects.so");
        writeControl writeTime;
    }
}
