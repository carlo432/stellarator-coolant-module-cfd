FoamFile
{
    version 2.0; format ascii; class dictionary; object controlDict;
}
application pimpleFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 0.8;
deltaT 0.0002;
writeControl adjustableRunTime;
writeInterval 0.05;
purgeWrite 3;
writeFormat ascii;
writePrecision 8;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable true;
adjustTimeStep yes;
maxCo 0.6;
maxDeltaT 0.001;
functions
{
    fieldAverage1
    {
        type fieldAverage; libs (fieldFunctionObjects);
        writeControl writeTime;
        timeStart 0.25;
        fields ( U { mean on; prime2Mean on; base time; } T { mean on; prime2Mean on; base time; } );
    }
    transportT
    {
        type scalarTransport; libs (solverFunctionObjects);
        field T; schemesField U; resetOnStartUp false;
        // alphaD/alphaDt force the turbulence-model path: D_eff = alphaD*nu + alphaDt*nut
        alphaD 0.069444444; alphaDt 1.1111111;
        fvOptions
        {
            frozenNeutronicsHeating
            {
                type scalarSemiImplicitSource; active true; selectionMode all;
                volumeMode specific;   // K/s = q'''/(rho*cp), frozen OpenMC shape (C3 near-flat)
                sources { T (3.21739 0); }
            }
        }
    }
    yPlus1 { type yPlus; libs (fieldFunctionObjects); writeControl writeTime; }
}
