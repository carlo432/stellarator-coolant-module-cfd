FoamFile
{
    version         2;
    format          ascii;
    class           volVectorField;
    object          U;
}

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 0.8699 0 0 );

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ( 0.8699 0 0 );
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform ( 0 0 0 );
    }
    "(fluidTop|fluidSides|bottomWater_to_heater)"
    {
        type            noSlip;
    }
}


