FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          k;
}

dimensions      [ 0 2 -2 0 0 0 0 ];

internalField   uniform 0.005044;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.005044;
        inletValue      uniform 0.005044;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.00505;
        value           uniform 0.00505;
    }
    "(fluidTop|fluidSides|bottomWater_to_heater)"
    {
        type            kqRWallFunction;
        value           uniform 0.00505;
    }
}


