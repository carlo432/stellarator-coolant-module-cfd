FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          T;
}

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 800;

boundaryField
{
    heatedBase
    {
        type            fixedGradient;
        gradient        uniform 16666.7;
    }
    solidSides
    {
        type            zeroGradient;
    }
    heater_to_bottomWater
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 800;
    }
}


