FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.8;

deltaT          0.0001;

writeControl    runTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       0.00025;

functions
{
    recircProbes
    {
        type            probes;
        libs            ( "libsampling.so" );
        writeControl    timeStep;
        writeInterval   5;
        fields          ( U p );
        probeLocations  ( ( 0.2 -0.03 0.02 ) ( 0.15 -0.035 0.02 ) ( 0.26 -0.035 0.02 ) );
    }
    inletP
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        regionType      patch;
        name            inlet;
        operation       areaAverage;
        fields          ( p );
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
    }
    outletP
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        regionType      patch;
        name            outlet;
        operation       areaAverage;
        fields          ( p );
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
    }
}


