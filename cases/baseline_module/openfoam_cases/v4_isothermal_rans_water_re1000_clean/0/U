FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

// Re = 1000 with water debug properties and Dh = 0.02667 m.
internalField   uniform (0.0335 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0.0335 0 0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    heated_wall
    {
        type            noSlip;
    }

    adiabatic_walls
    {
        type            noSlip;
    }
}
