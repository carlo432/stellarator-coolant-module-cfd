FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

// Re = 10000 with FLiBe-like placeholder properties and Dh = 0.02667 m.
internalField   uniform (1.1598 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1.1598 0 0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    heated_wall
    {
        type            noSlip;
    }

    adiabatic_walls
    {
        type            noSlip;
    }
}
