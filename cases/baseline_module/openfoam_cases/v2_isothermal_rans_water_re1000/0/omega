FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 0.7;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.7;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.7;
        value           uniform 0.7;
    }

    heated_wall
    {
        type            omegaWallFunction;
        value           uniform 0.7;
    }

    adiabatic_walls
    {
        type            omegaWallFunction;
        value           uniform 0.7;
    }
}
